    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>..\Libs\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\translations.csv" Link="translations.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\translations_extra.csv" Link="translations_extra.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(SkipDeploy)' != 'true' And Exists('D:\Games\Two Point Hospital\BepInEx\plugins')">
    <MakeDir Directories="D:\Games\Two Point Hospital\BepInEx\plugins\UnderPressure" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="D:\Games\Two Point Hospital\BepInEx\plugins\UnderPressure" />
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).pdb" DestinationFolder="D:\Games\Two Point Hospital\BepInEx\plugins\UnderPressure" Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" />
    <Copy SourceFiles="$(ProjectDir)..\translations.csv" DestinationFolder="D:\Games\Two Point Hospital\BepInEx\plugins\UnderPressure" />
    <Copy SourceFiles="$(ProjectDir)..\translations_extra.csv" DestinationFolder="D:\Games\Two Point Hospital\BepInEx\plugins\UnderPressure" />
  </Target>
</Project>
